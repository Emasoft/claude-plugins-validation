.DS_Store
Thumbs.db

# Environment
.env
.env.*

# Dev folders (NEVER PUBLISH - development artifacts only)
# Wildcard pattern catches all: docs_dev, scripts_dev, tests_dev, samples_dev,
# examples_dev, downloads_dev, libs_dev, builds_dev, etc.
*_dev/

# Agent/script reports — ALWAYS gitignored since they often contain private data
# (full paths, source snippets, API output, validation results, env metadata).
# Canonical rule (~/.claude/rules/agent-reports-location.md): every
# agent/skill/script that saves a report MUST write under the main-repo
# `./reports/<component>/<YYYYMMDD_HHMMSS±HHMM>-<slug>.md`. Neither
# `reports/` nor `reports_dev/` may ever be tracked. `reports_dev/` is
# separately also matched by the `*_dev/` rule above, but it's listed
# explicitly here because the rule says both entries must be present.
reports/
reports_dev/

# Internal review reports (e.g. /review-loop-opus output). Same rationale as
# reports/: they contain absolute paths, internal notes, and per-session
# scratch — never publish them.
reviews/

# Cisco AI Defense skill-scanner runtime artifact (full plugin scan output;
# token-heavy and project-private)
.cpv-cisco-scan.json

# ai-maestro-janitor runtime state (per-machine: heartbeat timestamps,
# safe-delete logs, dedupe seen-files). Never source.
.janitor/

# Trashcan — janitor-safe-delete moves removed items here.
# The dated batch dirs are ignored, but .gitkeep + README.txt are
# tracked so the trashcan survives `git clean -fdx` and fresh clones.
# (The actual /.trashcan/* + negation rules live near the bottom of
# this file — added by safe-delete.sh on first use.)

# Node
node_modules/

# Rust
target/
Cargo.lock
.rechecker/
# TLDR artifacts (added by rechecker)
.tldr_session_*
# Rechecker merge-pending notification files
rck-*-merge-pending.md
/.trashcan/*
!/.trashcan/.gitkeep
!/.trashcan/README.txt

# gh CLI per-host state directory created when running gh inside this repo.
.local/
