#!/usr/bin/env bash
# pre-commit hook for claude-plugins-validation
# Validates plugin structure before allowing commits
#
# Exit codes from validate_plugin.py:
#   0 - All checks passed
#   1 - CRITICAL issues found (blocks commit)
#   2 - MAJOR issues found (blocks commit)
#   3 - MINOR issues found (allows commit with warning)

set -euo pipefail

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get the root directory of the git repository
REPO_ROOT="$(git rev-parse --show-toplevel)"

echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}  Pre-commit Plugin Validation${NC}"
echo -e "${BLUE}========================================${NC}"

# Check if there are staged changes to plugin files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No staged files to validate.${NC}"
    exit 0
fi

# Check if any plugin-related files are staged
PLUGIN_FILES_CHANGED=false
while IFS= read -r file; do
    case "$file" in
        .claude-plugin/*|agents/*|commands/*|skills/*|hooks/*|scripts/*.py|scripts/*.sh|*.mcp.json)
            PLUGIN_FILES_CHANGED=true
            echo -e "  ${BLUE}Staged:${NC} $file"
            ;;
    esac
done <<< "$STAGED_FILES"

if [ "$PLUGIN_FILES_CHANGED" = false ]; then
    echo -e "${GREEN}No plugin files staged. Skipping validation.${NC}"
    exit 0
fi

echo ""
echo -e "${BLUE}Running plugin validation...${NC}"
echo ""

# Run the plugin validator
cd "$REPO_ROOT"

# Use uv if available, otherwise fall back to python
if command -v uv &> /dev/null; then
    PYTHON_CMD="uv run python"
else
    PYTHON_CMD="python3"
fi

# Run validation and capture exit code
set +e
$PYTHON_CMD scripts/validate_plugin.py . 2>&1
VALIDATION_EXIT_CODE=$?
set -e

echo ""
echo -e "${BLUE}----------------------------------------${NC}"

# Handle exit codes
case $VALIDATION_EXIT_CODE in
    0)
        echo -e "${GREEN}PASSED: All validation checks passed.${NC}"
        echo -e "${GREEN}Commit allowed.${NC}"
        exit 0
        ;;
    1)
        echo -e "${RED}BLOCKED: CRITICAL issues found.${NC}"
        echo -e "${RED}Fix critical issues before committing.${NC}"
        exit 1
        ;;
    2)
        echo -e "${RED}BLOCKED: MAJOR issues found.${NC}"
        echo -e "${RED}Fix major issues before committing.${NC}"
        exit 1
        ;;
    3)
        echo -e "${YELLOW}WARNING: Minor issues found.${NC}"
        echo -e "${GREEN}Commit allowed (minor issues only).${NC}"
        exit 0
        ;;
    *)
        echo -e "${RED}ERROR: Validation script failed with exit code $VALIDATION_EXIT_CODE${NC}"
        echo -e "${RED}Please check the validation script.${NC}"
        exit 1
        ;;
esac
