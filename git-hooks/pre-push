#!/usr/bin/env python3
"""Pre-push hook for claude-plugins-validation.

Performs full validation before allowing push.

Exit codes from validate_plugin.py:
  0 - All checks passed
  1 - CRITICAL issues found (blocks push)
  2 - MAJOR issues found (blocks push)
  3 - MINOR issues found (blocks push)
  4 - NIT issues found (blocks push; only emitted under --strict)

This hook always runs validate_plugin.py with --strict, so exit code 4
(NIT-only findings) is a normal, expected blocking result here — not a
script crash. Every non-zero exit code blocks the push.
"""

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

# ---------------------------------------------------------------------------
# ANSI color helpers (disabled on Windows unless colorama is available)
# ---------------------------------------------------------------------------


def _colors_supported() -> bool:
    """Return True when the terminal likely supports ANSI escape codes."""
    if os.environ.get("NO_COLOR"):
        return False
    if os.name == "nt":
        # On Windows, try to enable ANSI support via colorama
        try:
            import colorama

            colorama.init()
            return True
        except ImportError:
            return False
    # Unix-like systems: support ANSI if stdout is a terminal
    return hasattr(sys.stdout, "isatty") and sys.stdout.isatty()


_USE_COLOR = _colors_supported()

RED = "\033[0;31m" if _USE_COLOR else ""
YELLOW = "\033[1;33m" if _USE_COLOR else ""
GREEN = "\033[0;32m" if _USE_COLOR else ""
BLUE = "\033[0;34m" if _USE_COLOR else ""
NC = "\033[0m" if _USE_COLOR else ""  # No Color

# The all-zeros SHA indicates branch creation / deletion in git hooks
ZERO_SHA = "0000000000000000000000000000000000000000"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------


def cprint(msg: str) -> None:
    """Print a message to stdout (handles encoding gracefully)."""
    print(msg, flush=True)


def get_repo_root() -> Path:
    """Return the absolute path to the git repository root."""
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    )
    return Path(result.stdout.strip())


def _get_process_ancestry(max_depth: int = 30) -> list[tuple[int, str]]:
    """Walk the process tree from this process up to PID 1.

    Returns a list of (pid, command_line) tuples from closest ancestor to root.
    Uses `ps` which is available on macOS, Linux, and BSD.
    Returns empty list if the walk fails (caller treats as fail-closed).
    """
    ancestry: list[tuple[int, str]] = []
    pid = os.getpid()
    seen: set[int] = set()
    for _ in range(max_depth):
        if pid in seen or pid <= 0:
            break
        seen.add(pid)
        try:
            result = subprocess.run(
                ["ps", "-p", str(pid), "-o", "ppid=,args="],
                capture_output=True,
                text=True,
                timeout=5,
            )
        except (OSError, subprocess.SubprocessError):
            return []
        if result.returncode != 0:
            break
        line = result.stdout.strip()
        if not line:
            break
        parts = line.split(None, 1)
        if not parts:
            break
        try:
            ppid = int(parts[0])
        except ValueError:
            break
        cmdline = parts[1] if len(parts) > 1 else ""
        ancestry.append((pid, cmdline))
        if ppid <= 1:
            break
        pid = ppid
    return ancestry


def _called_by_publish_py(repo_root: Path) -> bool:
    """Check if any ancestor process is the publish.py script from this repo.

    Uses process ancestry (not env vars) — env vars are trivially spoofable,
    process ancestry is not. Walks the process tree via `ps` and verifies
    that publish.py from THIS repository is an ancestor of the current hook
    invocation.

    The expected chain is:
        publish.py → git push → git (pre-push hook)
    """
    ancestry = _get_process_ancestry()
    if not ancestry:
        return False

    expected_path = str((repo_root / "scripts" / "publish.py").resolve())
    expected_basename = "scripts/publish.py"

    for _pid, cmdline in ancestry:
        if "publish.py" not in cmdline:
            continue
        # Strict match: the absolute path of THIS repo's publish.py must be in
        # the command line, OR the path component "scripts/publish.py" must be
        # present (in case the cwd is repo_root and the script is invoked with
        # a relative path like `python scripts/publish.py --patch`).
        if expected_path in cmdline or expected_basename in cmdline:
            return True
    return False


def find_python_command() -> list[str]:
    """Return the Python invocation command as a list of args.

    Prefers ``uv run python``; falls back to ``python3``.
    """
    try:
        subprocess.run(
            ["uv", "--version"],
            capture_output=True,
            text=True,
            check=True,
        )
        return ["uv", "run", "python"]
    except (FileNotFoundError, subprocess.CalledProcessError):
        return ["python3"]


def run_script(
    python_cmd: list[str],
    script: Path,
    args: list[str] | None = None,
    timeout: int = 180,
    cwd: Path | None = None,
) -> int:
    """Run a Python script and return its exit code, streaming output."""
    cmd = [*python_cmd, str(script)]
    if args:
        cmd.extend(args)
    try:
        result = subprocess.run(cmd, timeout=timeout, cwd=str(cwd) if cwd else None)
        return result.returncode
    except subprocess.TimeoutExpired:
        # FAIL-CLOSED: a timeout means validation did NOT complete, so we do NOT
        # know the tree is clean. Returning 0 here let an unvalidated tree push,
        # silently defeating the iron-rule pre-push gate. Return non-zero so the
        # push is BLOCKED — re-run with a longer timeout or fix the slowness.
        # (audit MAJOR publish #3)
        print(f"  {RED}TIMEOUT: {script.name} exceeded {timeout}s — FAILED (push blocked){NC}")
        return 1


def extract_version(filepath: Path) -> str | None:
    """Extract the ``version`` field from a JSON file, or return None."""
    try:
        data = json.loads(filepath.read_text(encoding="utf-8"))
        return data.get("version")
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


def extract_name(filepath: Path) -> str | None:
    """Extract the ``name`` field from a JSON file, or return None.

    Used to allow the ``{name}--v{version}`` dependency-resolution tag through the
    tag guard. Returns None on any read/parse problem, in which case the guard
    simply falls back to allowing only ``v{version}`` — a failure to read the name
    must never widen what is accepted.
    """
    try:
        data = json.loads(filepath.read_text(encoding="utf-8"))
        name = data.get("name")
        return str(name) if name else None
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


# ---------------------------------------------------------------------------
# Branch-aware gate helpers (issue #169)
# ---------------------------------------------------------------------------


def _resolve_default_branch(repo_root: Path) -> str | None:
    """Return the default branch name from origin/HEAD (e.g. 'master'), or None.

    Used to decide which pushes are RELEASE pushes. Failure to resolve simply
    means we fall back to the hard-coded main/master pair — it never widens what
    is treated as a feature branch.
    """
    try:
        r = subprocess.run(
            ["git", "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD"],
            capture_output=True,
            text=True,
            cwd=str(repo_root),
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode == 0 and r.stdout.strip():
        # "origin/master" -> "master"
        return r.stdout.strip().split("/")[-1]
    return None


def _ref_is_release(
    push: tuple[str, str, str, str], default_branch: str | None
) -> bool:
    """A push is RELEASE-gated when it targets a tag or the default branch.

    'main' and 'master' are ALWAYS release branches (a repo uses one as its
    default and no feature branch is ever named that), plus whatever origin/HEAD
    resolves to. Every other branch is a shareable feature branch.
    """
    kind, _local_sha, _remote_sha, name = push
    if kind == "tag":
        return True
    if name in ("main", "master"):
        return True
    return default_branch is not None and name == default_branch


def _secret_scan_base(
    repo_root: Path, remote_sha: str, default_branch: str | None
) -> str | None:
    """The commit to start the secret scan from — scan ONLY the new commits.

    For an existing remote branch that is the remote's current tip (remote_sha).
    For a brand-new branch (remote side all-zeros) fall back to the default
    branch tip so already-pushed history is not re-scanned. If neither resolves,
    return None (scan the whole branch — a fresh repo has no inherited history to
    false-positive on).
    """
    if remote_sha and remote_sha != ZERO_SHA:
        return remote_sha
    if default_branch:
        for ref in (f"origin/{default_branch}", default_branch):
            try:
                r = subprocess.run(
                    ["git", "rev-parse", "--verify", "--quiet", ref],
                    capture_output=True,
                    text=True,
                    cwd=str(repo_root),
                    timeout=10,
                )
            except (OSError, subprocess.SubprocessError):
                continue
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
    return None


def _run_feature_secret_gate(
    repo_root: Path,
    feature_refs: list[tuple[str, str, str, str]],
    default_branch: str | None,
) -> int:
    """Secret-scan the commits being pushed to feature branches.

    A feature-branch push does NOT require publish.py ancestry (that release
    gate is for the default branch and tags) — but it MUST NOT leak a secret, so
    every pushed commit range is scanned with trufflehog. Fail-closed: if
    trufflehog is not installed the push is BLOCKED (an unscanned push is never
    silently allowed). Returns 0 to allow, non-zero to block.
    """
    cprint(f"{BLUE}========================================{NC}")
    cprint(f"{BLUE}  Feature-branch push — secret scan{NC}")
    cprint(f"{BLUE}========================================{NC}")
    if shutil.which("trufflehog") is None:
        cprint(f"{RED}========================================{NC}")
        cprint(f"{RED}  BLOCKED: trufflehog is not installed.{NC}")
        cprint(f"{RED}  A feature-branch push must be secret-scanned first.{NC}")
        cprint(f"{RED}  Install: https://github.com/trufflesecurity/trufflehog{NC}")
        cprint(f"{RED}  (or push through scripts/publish.py){NC}")
        cprint(f"{RED}========================================{NC}")
        return 1
    for _kind, _local_sha, remote_sha, name in feature_refs:
        base = _secret_scan_base(repo_root, remote_sha, default_branch)
        cmd = ["trufflehog", "git", f"file://{repo_root}", "--branch", name]
        if base:
            cmd += ["--since-commit", base]
        cmd += ["--no-update", "--fail"]
        cprint(f"{BLUE}Scanning '{name}'...{NC}")
        try:
            result = subprocess.run(cmd, cwd=str(repo_root), timeout=300)
        except (OSError, subprocess.SubprocessError) as exc:
            # FAIL-CLOSED: a scan that could not run has NOT proven the branch
            # clean, so it must never let the push through.
            cprint(f"{RED}  BLOCKED: secret scan could not run for '{name}' ({exc}).{NC}")
            return 1
        if result.returncode != 0:
            cprint(f"{RED}========================================{NC}")
            cprint(f"{RED}  BLOCKED: secret scan flagged '{name}'.{NC}")
            cprint(f"{RED}  Remove the secret(s) before pushing.{NC}")
            cprint(f"{RED}========================================{NC}")
            return 1
    cprint(f"{GREEN}========================================{NC}")
    cprint(f"{GREEN}  Secret scan clean — feature push allowed.{NC}")
    cprint(f"{GREEN}========================================{NC}")
    return 0


# ---------------------------------------------------------------------------
# Main logic
# ---------------------------------------------------------------------------


def main() -> int:
    repo_root = get_repo_root()

    # The git pre-push hook receives REMOTE and URL as positional args
    remote = sys.argv[1] if len(sys.argv) > 1 else "<unknown>"
    url = sys.argv[2] if len(sys.argv) > 2 else "<unknown>"

    # Read stdin ONCE: each line is LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA.
    stdin_lines = sys.stdin.read().strip().splitlines()

    # Classify the refs being pushed into typed tuples, skipping deletions
    # (local side is the all-zeros SHA — nothing to gate or scan).
    pushes: list[tuple[str, str, str, str]] = []  # (kind, local_sha, remote_sha, name)
    for line in stdin_lines:
        parts = line.split()
        if len(parts) < 4:
            continue
        local_ref, local_sha, _remote_ref, remote_sha = parts[:4]
        if local_sha == ZERO_SHA:
            continue
        if local_ref.startswith("refs/tags/"):
            pushes.append(("tag", local_sha, remote_sha, local_ref[len("refs/tags/") :]))
        elif local_ref.startswith("refs/heads/"):
            pushes.append(("branch", local_sha, remote_sha, local_ref[len("refs/heads/") :]))

    default_branch = _resolve_default_branch(repo_root)
    release_refs = [pp for pp in pushes if _ref_is_release(pp, default_branch)]
    feature_refs = [pp for pp in pushes if not _ref_is_release(pp, default_branch)]

    # ── Feature-branch-only push (issue #169): NO publish.py ancestry required.
    #    Fleets / reviewers / CI must be able to share a feature branch. Allowed
    #    only after a passing secret scan of the pushed commits. A release ref
    #    (default branch or tag) — or an empty/unparseable push — falls through
    #    to the full release gate below.
    if feature_refs and not release_refs:
        return _run_feature_secret_gate(repo_root, feature_refs, default_branch)

    # ── Release path: default branch and/or tags (or nothing parsed). ──
    # Pipeline enforcement: only publish.py may push. Uses PROCESS ANCESTRY,
    # not env vars. Env vars are trivially spoofable
    # (`CPV_PUBLISH_PIPELINE=1 git push` bypasses the check); process ancestry
    # is not. The hook walks its parent chain up to PID 1 via `ps` and requires
    # that scripts/publish.py from THIS repo is an ancestor of the push.
    if not _called_by_publish_py(repo_root):
        cprint(f"{RED}========================================{NC}")
        cprint(f"{RED}  BLOCKED: Direct push not allowed{NC}")
        cprint(f"{RED}  This hook only accepts pushes initiated by{NC}")
        cprint(f"{RED}  scripts/publish.py (verified via process ancestry).{NC}")
        cprint(f"{RED}  Use: uv run python scripts/publish.py --patch{NC}")
        cprint(f"{RED}  (Feature-branch pushes are allowed after a secret scan.){NC}")
        cprint(f"{RED}========================================{NC}")
        return 1

    cprint(f"{BLUE}========================================{NC}")
    cprint(f"{BLUE}  Pre-push Full Plugin Validation{NC}")
    cprint(f"{BLUE}========================================{NC}")
    cprint("")

    cprint(f"{BLUE}Pushing to:{NC} {remote} ({url})")
    cprint("")

    # Names of the refs on the release path, for the version-bump section below.
    branch_refs: list[str] = [name for kind, _l, _r, name in pushes if kind == "branch"]
    tag_refs: list[str] = [name for kind, _l, _r, name in pushes if kind == "tag"]

    tag_only_push = bool(tag_refs) and not branch_refs
    if tag_only_push:
        cprint(f"{BLUE}Tag push detected: {', '.join(tag_refs)}{NC}")
    elif branch_refs:
        cprint(f"{BLUE}Branch push detected: {', '.join(branch_refs)}{NC}")

    # Full validation ALWAYS runs. No bypass based on file patterns or ref type.
    # The lint/test/validate steps are mandatory for every push (branch OR tag).

    # --- Version bump enforcement ---
    # Block push if local version is not greater than remote version.
    # For tag-only pushes, verify that the tag name matches the local version
    # (publish.py pushes the branch first, then the tag; at tag-push time the
    # remote master is already at the new version, so the "strictly greater"
    # rule would fail. Instead, verify tag name == local version).
    cprint(f"{BLUE}Checking version bump...{NC}")

    local_version = extract_version(repo_root / ".claude-plugin" / "plugin.json")
    if local_version:
        if tag_only_push:
            # For tag pushes: every pushed tag must name THIS version. A release
            # legitimately pushes TWO tags:
            #   v<version>                  — the human-facing release tag
            #   <plugin-name>--v<version>   — the DEPENDENCY-RESOLUTION tag that
            #                                 Claude Code resolves a
            #                                 version-constrained dependency
            #                                 against (it IGNORES the plain tag).
            # Both are pushed in one atomic push, so the guard must accept both.
            # It stays strict: a tag naming any OTHER version, or any other shape,
            # is still blocked — this widens the allowlist, it does not disable it.
            expected_tag = f"v{local_version}"
            allowed = {expected_tag}
            plugin_name = extract_name(repo_root / ".claude-plugin" / "plugin.json")
            if plugin_name:
                allowed.add(f"{plugin_name}--v{local_version}")
            mismatched = [t for t in tag_refs if t not in allowed]
            if mismatched:
                cprint(f"{RED}========================================{NC}")
                cprint(f"{RED}  BLOCKED: Tag name does not match plugin version!{NC}")
                cprint(f"{RED}  Pushed tag(s): {', '.join(mismatched)}{NC}")
                cprint(f"{RED}  Expected one of: {', '.join(sorted(allowed))}{NC}")
                cprint(f"{RED}  Run: uv run python scripts/publish.py --patch{NC}")
                cprint(f"{RED}========================================{NC}")
                return 1
            cprint(f"{GREEN}Tag(s) match local version: {', '.join(sorted(tag_refs))}{NC}")
        else:
            # For branch pushes: local version must be strictly greater than remote.
            # Resolve origin/HEAD dynamically so this works on main OR master
            # default branches (audit finding v2.12.27 MAJOR #5).
            candidate_refs: list[str] = []
            try:
                sym = subprocess.run(
                    ["git", "symbolic-ref", "refs/remotes/origin/HEAD"],
                    capture_output=True,
                    text=True,
                    cwd=str(repo_root),
                    timeout=10,
                )
                if sym.returncode == 0 and sym.stdout.strip():
                    branch = sym.stdout.strip().split("/")[-1]
                    candidate_refs.append(f"origin/{branch}")
            except (OSError, subprocess.SubprocessError):
                pass
            for fallback in ("origin/main", "origin/master"):
                if fallback not in candidate_refs:
                    candidate_refs.append(fallback)

            remote_version: str | None = None
            matched_ref: str | None = None
            for ref in candidate_refs:
                try:
                    remote_result = subprocess.run(
                        ["git", "show", f"{ref}:.claude-plugin/plugin.json"],
                        capture_output=True,
                        text=True,
                        cwd=str(repo_root),
                        timeout=10,
                    )
                except (OSError, subprocess.SubprocessError):
                    continue
                if remote_result.returncode == 0 and remote_result.stdout:
                    try:
                        rv = json.loads(remote_result.stdout).get("version")
                        if isinstance(rv, str):
                            remote_version = rv
                            matched_ref = ref
                            break
                    except json.JSONDecodeError:
                        continue

            if remote_version is None:
                # No remote plugin.json on any candidate branch — first push.
                cprint(f"{GREEN}Version: {local_version} (first push, no remote plugin.json){NC}")
            elif local_version == remote_version:
                cprint(f"{RED}========================================{NC}")
                cprint(f"{RED}  BLOCKED: Version not bumped!{NC}")
                cprint(f"{RED}  Local: {local_version}  {matched_ref}: {remote_version}{NC}")
                cprint(f"{RED}  Run: uv run python scripts/publish.py --patch{NC}")
                cprint(f"{RED}========================================{NC}")
                return 1
            else:
                cprint(f"{GREEN}Version bump OK: {remote_version} → {local_version} (via {matched_ref}){NC}")
    else:
        cprint(f"{YELLOW}No local version found — skipping version check{NC}")

    cprint("")
    cprint(f"{BLUE}Running full plugin validation...{NC}")
    cprint("")

    python_cmd = find_python_command()

    # --- Validation (lint is folded into validate_plugin.py via cpv_lint_engine, v2.64.0+) ---
    validate_script = repo_root / "scripts" / "validate_plugin.py"
    # --strict: NIT issues also block push (zero tolerance)
    validation_exit = run_script(python_cmd, validate_script, [".", "--verbose", "--strict"], cwd=repo_root)

    cprint("")
    cprint(f"{BLUE}----------------------------------------{NC}")

    # --- Marketplace version consistency ---
    marketplace_json = repo_root / "marketplace.json"
    if marketplace_json.is_file():
        cprint(f"{BLUE}Checking marketplace.json consistency...{NC}")

        plugin_json = repo_root / ".claude-plugin" / "plugin.json"
        if plugin_json.is_file():
            plugin_version = extract_version(plugin_json)
            marketplace_version = extract_version(marketplace_json)

            if plugin_version and marketplace_version:
                if plugin_version != marketplace_version:
                    cprint(f"{YELLOW}WARNING: Version mismatch!{NC}")
                    cprint(f"  plugin.json version: {plugin_version}")
                    cprint(f"  marketplace.json version: {marketplace_version}")
                    cprint(f"{YELLOW}Consider updating marketplace.json to match.{NC}")
                else:
                    cprint(f"{GREEN}Version consistency: OK ({plugin_version}){NC}")

    cprint("")

    # --- Handle validation exit codes ---
    if validation_exit == 0:
        cprint(f"{GREEN}========================================{NC}")
        cprint(f"{GREEN}  PASSED: All validation checks passed{NC}")
        cprint(f"{GREEN}  Push allowed.{NC}")
        cprint(f"{GREEN}========================================{NC}")
        return 0
    elif validation_exit == 1:
        cprint(f"{RED}========================================{NC}")
        cprint(f"{RED}  BLOCKED: CRITICAL issues found{NC}")
        cprint(f"{RED}  Fix ALL issues before pushing.{NC}")
        cprint(f"{RED}========================================{NC}")
        return 1
    elif validation_exit == 2:
        cprint(f"{RED}========================================{NC}")
        cprint(f"{RED}  BLOCKED: MAJOR issues found{NC}")
        cprint(f"{RED}  Fix ALL issues before pushing.{NC}")
        cprint(f"{RED}========================================{NC}")
        return 1
    elif validation_exit == 3:
        cprint(f"{YELLOW}========================================{NC}")
        cprint(f"{YELLOW}  BLOCKED: MINOR issues found{NC}")
        cprint(f"{YELLOW}  Fix ALL issues before pushing.{NC}")
        cprint(f"{YELLOW}========================================{NC}")
        return 1
    elif validation_exit == 4:
        # --strict (always passed below) makes validate_plugin.py return 4 for
        # NIT-only findings. Without this branch a clean-but-for-one-NIT tree
        # would fall into the catch-all `else` and be mislabeled as a validator
        # CRASH ("ERROR: ... check the validation script"), confusing the user
        # into debugging the script instead of fixing the NIT.
        cprint(f"{YELLOW}========================================{NC}")
        cprint(f"{YELLOW}  BLOCKED: NIT issues found (--strict){NC}")
        cprint(f"{YELLOW}  Fix ALL issues before pushing.{NC}")
        cprint(f"{YELLOW}========================================{NC}")
        return 1
    else:
        cprint(f"{RED}========================================{NC}")
        cprint(f"{RED}  ERROR: Validation failed (exit {validation_exit}){NC}")
        cprint(f"{RED}  Please check the validation script.{NC}")
        cprint(f"{RED}========================================{NC}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
